 experience. For each project: the question, your specific role, the methods you used, and how long you worked on it.\n\n","DataExportTag":"research_exp","QuestionID":"QID16","QuestionType":"TE","Selector":"ESTB","QuestionDescription":"Describe your prior research experience. For each project: the question, your specific role, the...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"SearchSource":{"AllowFreeResponse":"false"},"DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"NextChoiceId":1,"NextAnswerId":1}},{"SurveyID":"SV_80JaBioS6qbO594","Element":"SQ","PrimaryAttribute":"QID17","SecondaryAttribute":"Which piece of work are you proudest of, and what did you personally contribute to it?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which piece of work are you proudest of, and what did you personally contribute to it?\n\n","DataExportTag":"research_best","QuestionID":"QID17","QuestionType":"TE","Selector":"ESTB","QuestionDescription":"Which piece of work are you proudest of, and what did you personally contribute to it?","Validation":{"Settings":{"Type":"None"}},"Language":[],"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_80JaBioS6qbO594","Element":"SQ","PrimaryAttribute":"QID18","SecondaryAttribute":"Publications, preprints, abstracts, or presentations (optional). Citations or links are fine.","TertiaryAttribute":null,"Payload":{"QuestionText":"Publications, preprints, abstracts, or presentations (optional). Citations or links are fine.\n\n","DataExportTag":"pubs","QuestionID":"QID18","QuestionType":"TE","Selector":"ESTB","QuestionDescription":"Publications, preprints, abstracts, or presentations (optional). Citations or links are fine.","Validation":{"Settings":{"Type":"None"}},"Language":[],"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_80JaBioS6qbO594","Element":"SQ","PrimaryAttribute":"QID19","SecondaryAttribute":"What draws you to this lab's work, and what would you hope to learn or do here?","TertiaryAttribute":null,"Payload":{"QuestionText":"What draws you to this lab's work, and what would you hope to learn or do here?\n\n\n","DataExportTag":"why","QuestionID":"QID19","QuestionType":"TE","Selector":"ESTB","QuestionDescription":"What draws you to this lab's work, and what would you hope to learn or do here?","Validation":{"Settings":{"Type":"None"}},"Language":[],"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_80JaBioS6qbO594","Element":"SQ","PrimaryAttribute":"QID2","SecondaryAttribute":"Murthy Lab \u00b7 Expression of interest Use this form if you would like to be considered for future r..","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Murthy Lab &middot; Expression of interest<\/strong><br \/>\n<br \/>\nUse this form if you would like to be considered for future roles in the Murthy Lab at the University of Michigan. It is not an application for a posted position: those must be submitted through the University of Michigan careers site linked from <a href=\"https:\/\/murthylab.org\/join.html\">murthylab.org\/join.html<\/a>.<br \/>\n<br \/>\nWe try to read every submission carefully, but we may not be able to reply to each one. We will contact you if a role opens that fits your background. The form takes about ten minutes; please have your CV or resume ready to upload as a PDF or Word file.","DataExportTag":"intro","QuestionID":"QID2","QuestionType":"DB","Selector":"TB","QuestionDescription":"Murthy Lab \u00b7 Expression of interest Use this form if you would like to be considered for future r...","Validation":{"Settings":{"Type":"None"}},"Language":[],"DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"ChoiceOrder":[],"NextChoiceId":1,"NextAnswerId":1}},{"SurveyID":"SV_80JaBioS6qbO594","Element":"SQ","PrimaryAttribute":"QID20","SecondaryAttribute":"Data and computation skills. Check anything you have used in real work (a project, thesis, job, o...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Data and computation skills.<\/strong> Check anything you have used in real work (a project, thesis, job, or publication), not only in coursework. Leave boxes unchecked if unsure; we will ask about specifics in conversation.\n\n","DataExportTag":"data_intro","QuestionID":"QID20","QuestionType":"DB","Selector":"TB","QuestionDescription":"Data and computation skills. Check anything you have used in real work (a project, thesis, job, o...","Validation":{"Settings":{"Type":"None"}},"Language":[]}},{"SurveyID":"SV_80JaBioS6qbO594","Element":"SQ","PrimaryAttribute":"QID21","SecondaryAttribute":"Rate your proficiency with each of these.","TertiaryAttribute":null,"Payload":{"QuestionText":"Rate your proficiency with each of these.\n","DataExportTag":"data_level","QuestionID":"QID21","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","QuestionDescription":"Rate your proficiency with each of these.","Choices":{"1":{"Display":"R"},"2":{"Display":"Python"},"3":{"Display":"SQL"},"4":{"Display":"Git \/ GitHub"},"5":{"Display":"Unix command line"},"6":{"Display":"Deep learning frameworks (PyTorch, TensorFlow, JAX)"}},"ChoiceOrder":["1","2","3","4","5","6"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"Answers":{"1":{"Display":"Not used"},"2":{"Display":"Novice: coursework or short scripts"},"3":{"Display":"Intermediate: used regularly in a project"},"4":{"Display":"Advanced: built pipelines or analyses others rely on"},"5":{"Display":"Expert: wrote packages or production code, or teach it to others"}},"AnswerOrder":["1","2","3","4","5"],"DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"NextChoiceId":7,"NextAnswerId":6,"ChoiceDataExportTags":f