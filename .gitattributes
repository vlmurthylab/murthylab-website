# Lab core: identical in every lab repository; change it in
# vlmurthylab/project-template. Keep Unix line endings on scripts that git
# runs, so the PHI check works when checked out on Windows.
hooks/* text eol=lf
tools/*.pl text eol=lf
*.sh text eol=lf

# =============================================================================
# This repository: additions (keep the reason next to each rule)
# =============================================================================
# GitHub's language bar: the publications BibTeX file (tools/Lab_Website.bib)
# is larger than the site's HTML, so the repository showed as "TeX". Leave it
# out of the language statistics; nothing else changes.
*.bib linguist-detectable=false
