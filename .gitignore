*.exe
*.msi

# --- Checksum manifests and path maps: they list real file paths ------------
SHA256SUMS
SHA256SUMS*.txt
*.md5
*.sha256
upstream-checksums
upstream-checksums*.txt
STAT.baseline
pathmap*.tsv
pathmap*.csv
pathmap*.txt

# --- Secrets and local settings ----------------------------------------------
.env
.env.*
.Renviron
.pgpass
.netrc
.httr-oauth
.git-credentials
.aws/
.ssh/
id_rsa*
id_ecdsa*
id_ed25519*
client_secret*.json
credentials
credentials.cfg
credentials.toml
credentials.env
credentials.json
credentials.csv
credentials.txt
credentials.ini
credentials.yml
credentials.yaml
secrets
secrets.cfg
secrets.toml
secrets.env
secrets.json
secrets.csv
secrets.txt
secrets.ini
secrets.yml
secrets.yaml
*.pem
*.p12
*.pfx
*.ppk
*.keystore
*.jks
salt
*.salt

# --- Logs --------------------------------------------------------------------
*.log
slurm-*.out

# --- Editors and operating systems -------------------------------------------
.vscode/
.idea/
*.swp
*~
~$*
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Allowed: summary and reference tables (not subject-level data) ---------
!reference/**/*.csv
!reference/**/*.tsv
!results/tables/**/*.csv
!results/tables/**/*.tsv

